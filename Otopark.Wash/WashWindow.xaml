<Window x:Class="Otopark.Wash.WashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yıkama Ekranı" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Baslik + Yenile (Ucretsiz sure web'de tanimli; burada gosterilmez) -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="YIKAMA EKRANI" FontSize="26" FontWeight="Bold" Foreground="#1B2B4A" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RefreshBtn" Content="Yenile" Width="110" Height="36"
                        FontSize="15" Click="RefreshBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Sol: secili arac + fis sonucu | Orta: YIKANACAKLAR | Sag: son 15 arac -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Sol panel -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,12,0"
                    BorderBrush="#E6EAF2" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Seçili Araç" FontSize="18" FontWeight="Bold" Foreground="#6B7280"/>
                    <TextBlock x:Name="SelectedPlateText" Text="—" FontSize="48" FontWeight="Bold" Foreground="#111827" Margin="0,6,0,16"/>

                    <TextBlock x:Name="SelectedInfoText" Text="Sağdaki listeden bir araç seçiniz." FontSize="18" Foreground="#374151" TextWrapping="Wrap"/>

                    <Button x:Name="PrintBtn" Content="FİŞ BAS" Height="80" FontSize="28" FontWeight="Bold"
                            Background="#2563EB" Foreground="White" Margin="0,28,0,0" IsEnabled="False"
                            Click="PrintBtn_Click"/>

                    <!-- Fis sonucu -->
                    <Border x:Name="ResultBox" Background="#F0FFF4" CornerRadius="10" Padding="16" Margin="0,24,0,0"
                            BorderBrush="#86EFAC" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ResultTitle" Text="" FontSize="22" FontWeight="Bold" Foreground="#059669"/>
                            <TextBlock x:Name="ResultDetail" Text="" FontSize="18" Foreground="#374151" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ORTA PANEL: YIKANACAKLAR -->
            <!-- Fis basilan (WASH_RECEIPT'e kaydedilen) araclar burada AYRI liste olarak durur.
                 Geri sayim burada da DEVAM eder; sure bitince kirmizi "Süre doldu" gorunur. -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="12" Margin="0,0,12,0"
                    BorderBrush="#93C5FD" BorderThickness="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="4,4,4,10">
                        <TextBlock Text="🚿 YIKANACAKLAR" FontSize="18" FontWeight="Bold" Foreground="#1D4ED8"/>
                        <TextBlock x:Name="WashListInfoText" Text="Fişi basılan araçlar" FontSize="12" Foreground="#6B7280"/>
                    </StackPanel>
                    <ListBox x:Name="WashList" Grid.Row="1" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#EFF6FF" CornerRadius="8" Padding="12,10" Margin="2,4"
                                        BorderBrush="#BFDBFE" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Plate}" FontSize="24" FontWeight="Bold" Foreground="#1E3A8A"/>
                                        <TextBlock Text="{Binding CountdownText}" FontSize="15" FontWeight="Bold"
                                                   Foreground="{Binding CountdownBrush}"/>
                                        <TextBlock Text="{Binding IcerideText}"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                                        <TextBlock Text="{Binding EntryTime, StringFormat='Giriş: {0:dd.MM.yyyy HH:mm}'}"
                                                   FontSize="12" Foreground="#6B7280"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Sag panel: son 1 saatte giris yapmis araclar -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="12"
                    BorderBrush="#E6EAF2" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Son 1 Saatte Giren Araçlar" FontSize="18" FontWeight="Bold" Foreground="#1B2B4A" Margin="4,4,4,10"/>
                    <ListBox x:Name="EntryList" Grid.Row="1" SelectionChanged="EntryList_SelectionChanged"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F9FAFB" CornerRadius="8" Padding="12,10" Margin="2,4"
                                        BorderBrush="#E5E7EB" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Plate}" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                                            <!-- Ucretsiz sureden GERIYE sayim; sure dolunca otopark ucreti gosterilir. -->
                                            <TextBlock Text="{Binding CountdownText}" FontSize="16" FontWeight="Bold"
                                                       Foreground="{Binding CountdownBrush}"/>
                                            <TextBlock Text="{Binding MinutesIn, StringFormat='{}{0} dk içeride'}" FontSize="12" Foreground="#9CA3AF"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="6" Padding="8,4"
                                                Background="{Binding WashedBrush}">
                                            <TextBlock Text="{Binding WashedText}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
