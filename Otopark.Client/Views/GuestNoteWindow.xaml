<Window x:Class="Otopark.Client.Views.GuestNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Misafir Arac"
        Width="720" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FB">

    <Border Margin="18" Background="White" CornerRadius="14" Padding="26"
            BorderBrush="#E6EAF2" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Misafir Arac Isareti" FontSize="24" FontWeight="Bold"
                       Foreground="#0D47A1" HorizontalAlignment="Center" Margin="0,0,0,14"/>

            <TextBlock x:Name="TxtPlate" FontSize="30" FontWeight="Bold" Foreground="#1B2B4A"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <!-- NE YAPTIGINI ACIKCA YAZ: personel "ucretsiz cikis" sanmasin. -->
            <Border Background="#E3F2FD" CornerRadius="10"
                    BorderBrush="#64B5F6" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Bu islem araci MISAFIR olarak isaretler ve aciklamayi kayda gecirir."
                               FontWeight="Bold" FontSize="15" Foreground="#0D47A1" Margin="0,0,0,6"/>
                    <TextBlock FontSize="14" Foreground="#37474F" TextWrapping="Wrap"
                               Text="UCRET ve BORC DEGISMEZ. Isaret yalnizca kayit ve raporlama icindir; web tarafinda 'Iptal / Plaka Islem Raporu' ekranindan 'Misafir Araclar' suzgeci ile goruntulenir."/>
                </StackPanel>
            </Border>

            <TextBlock Text="Aciklama (zorunlu)" Foreground="#6B7A99" FontSize="15" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtNote" Height="90" FontSize="18" Padding="10"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                     BorderBrush="#0D47A1" BorderThickness="2"
                     KeyDown="TxtNote_KeyDown"/>
            <TextBlock Text="Ornek: Belediye araci / Resmi ziyaret / Personel misafiri"
                       Foreground="#9AA5B8" FontSize="12" Margin="2,4,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="BtnVazgec" Content="Vazgec" Width="150" Height="52" FontSize="19" Margin="0,0,12,0"
                        Background="#E0E0E0" Foreground="#333" BorderThickness="0"
                        Click="BtnVazgec_Click"/>
                <Button x:Name="BtnOnayla" Content="Isaretle" Width="180" Height="52" FontSize="19"
                        Background="#1565C0" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Click="BtnOnayla_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
