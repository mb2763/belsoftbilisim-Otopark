<Window x:Class="Otopark.Client.Views.CancelReasonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giris Iptali"
        Width="720" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FB">

    <Border Margin="18" Background="White" CornerRadius="14" Padding="26"
            BorderBrush="#E6EAF2" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Giris Iptali" FontSize="24" FontWeight="Bold"
                       Foreground="#B71C1C" HorizontalAlignment="Center" Margin="0,0,0,14"/>

            <TextBlock x:Name="TxtPlate" FontSize="30" FontWeight="Bold" Foreground="#1B2B4A"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <!-- Cikisi yapilmis kayitlarda ne olacagini acikca yaz -->
            <Border x:Name="WarnBox" Visibility="Collapsed" Background="#FFF3E0" CornerRadius="10"
                    BorderBrush="#FFB74D" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="DIKKAT: Bu aracin CIKISI YAPILMIS." FontWeight="Bold"
                               FontSize="16" Foreground="#E65100" Margin="0,0,0,6"/>
                    <TextBlock FontSize="14" Foreground="#5D4037" TextWrapping="Wrap"
                               Text="Iptal ederseniz giris kaydi, cikis kaydi ve varsa ODENMEMIS borc birlikte iptal edilir; aracin borc bakiyesi iptal edilen borc kadar azaltilir. Odenmis (tahsil edilmis) borclara dokunulmaz."/>
                    <TextBlock FontSize="14" Foreground="#B71C1C" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Sadece plaka yanlis okunduysa IPTAL yerine plaka duzeltmeyi kullanin."/>
                </StackPanel>
            </Border>

            <TextBlock Text="Iptal Nedeni (zorunlu)" Foreground="#6B7A99" FontSize="15" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtReason" Height="90" FontSize="18" Padding="10"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                     BorderBrush="#B71C1C" BorderThickness="2"
                     KeyDown="TxtReason_KeyDown"/>
            <TextBlock Text="Ornek: Mukerrer giris / Plaka yanlis okundu / Arac girmedi"
                       Foreground="#9AA5B8" FontSize="12" Margin="2,4,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="BtnVazgec" Content="Vazgec" Width="150" Height="52" FontSize="19" Margin="0,0,12,0"
                        Background="#E0E0E0" Foreground="#333" BorderThickness="0"
                        Click="BtnVazgec_Click"/>
                <Button x:Name="BtnOnayla" Content="Iptal Et" Width="180" Height="52" FontSize="19"
                        Background="#C62828" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Click="BtnOnayla_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
