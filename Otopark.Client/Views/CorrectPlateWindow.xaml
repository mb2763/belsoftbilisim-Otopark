<Window x:Class="Otopark.Client.Views.CorrectPlateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plaka Duzelt"
        Width="900" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FB">

    <Border Margin="20" Background="White" CornerRadius="14" Padding="28"
            BorderBrush="#E6EAF2" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Plaka Duzelt" FontSize="26" FontWeight="Bold"
                       Foreground="#1B2B4A" HorizontalAlignment="Center" Margin="0,0,0,18"/>

            <!-- Arac fotografi (plakanin gorundugu giris gorseli) BUYUK: plaka net okunsun -->
            <StackPanel x:Name="PhotoPanel" Visibility="Collapsed" Margin="0,0,0,18">
                <TextBlock Text="Arac Fotografi" Foreground="#6B7A99" FontSize="16" Margin="0,0,0,6"/>
                <Border CornerRadius="10" BorderBrush="#DDE3EE" BorderThickness="1" ClipToBounds="True">
                    <Image x:Name="ImgPlate" Stretch="Uniform" MaxHeight="520"/>
                </Border>
            </StackPanel>

            <TextBlock Text="Eski Plaka" Foreground="#6B7A99" FontSize="16" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtOldPlate" Height="64" Padding="12,0" FontSize="34" FontWeight="Bold"
                     VerticalContentAlignment="Center" IsReadOnly="True"
                     Background="#F0F3F9" BorderBrush="#DDE3EE"/>

            <TextBlock Text="Yeni Plaka" Foreground="#6B7A99" FontSize="16" Margin="0,18,0,6"/>
            <TextBox x:Name="TxtNewPlate" Height="70" Padding="12,0" FontSize="38" FontWeight="Bold"
                     VerticalContentAlignment="Center"
                     BorderBrush="#2E7D32" BorderThickness="2" CharacterCasing="Upper"
                     MaxLength="10"
                     PreviewTextInput="TxtNewPlate_PreviewTextInput"
                     KeyDown="TxtNewPlate_KeyDown"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                <Button x:Name="BtnCancel" Content="Iptal" Width="140" Height="54" FontSize="20" Margin="0,0,12,0"
                        Background="#E0E0E0" Foreground="#333" BorderThickness="0"
                        Click="BtnCancel_Click"/>
                <Button x:Name="BtnSave" Content="Kaydet" Width="170" Height="54" FontSize="20"
                        Background="#2E7D32" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
