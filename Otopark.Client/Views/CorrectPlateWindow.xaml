<Window x:Class="Otopark.Client.Views.CorrectPlateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plaka Duzelt"
        Width="1150"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F7FB">
    <!--
        DUZEN NOTU: Onceden SizeToContent="Height" + StackPanel kullaniliyordu; fotograf
        buyuk oldugunda Kaydet/Iptal butonlari ekranin ALTINA tasiyor ve dusuk cozunurlukte
        HIC GORUNMUYORDU. Artik Grid kullaniliyor:
          Satir 0 : baslik
          Satir 1 : plaka alanlari + KAYDET / KAPAT butonlari  (HER ZAMAN USTTE ve gorunur)
          Satir 2 : yakinlastirma araclari
          Satir 3 : fotograf  (yildiz satir, ekrana sigacak sekilde KUCULUR)
        Pencere yuksekligi da kod tarafinda ekran calisma alanina gore sinirlanir.
    -->

    <Border Margin="14" Background="White" CornerRadius="14" Padding="20"
            BorderBrush="#E6EAF2" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 0: Baslik -->
            <TextBlock Grid.Row="0" Text="Plaka Duzelt" FontSize="24" FontWeight="Bold"
                       Foreground="#1B2B4A" HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <!-- 1: Plakalar + AKSIYON BUTONLARI (ustte, daima gorunur) -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Eski Plaka" Foreground="#6B7A99" FontSize="14" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtOldPlate" Height="54" Padding="10,0" FontSize="28" FontWeight="Bold"
                             VerticalContentAlignment="Center" IsReadOnly="True"
                             Background="#F0F3F9" BorderBrush="#DDE3EE"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Yeni Plaka" Foreground="#6B7A99" FontSize="14" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNewPlate" Height="54" Padding="10,0" FontSize="30" FontWeight="Bold"
                             VerticalContentAlignment="Center"
                             BorderBrush="#2E7D32" BorderThickness="2" CharacterCasing="Upper"
                             MaxLength="10"
                             PreviewTextInput="TxtNewPlate_PreviewTextInput"
                             KeyDown="TxtNewPlate_KeyDown"/>
                </StackPanel>

                <Button x:Name="BtnSave" Grid.Column="2" Content="KAYDET" Width="170" Height="54" FontSize="19"
                        VerticalAlignment="Bottom" Margin="0,0,10,0"
                        Background="#2E7D32" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Click="BtnSave_Click"/>
                <Button x:Name="BtnCancel" Grid.Column="3" Content="KAPAT" Width="130" Height="54" FontSize="19"
                        VerticalAlignment="Bottom"
                        Background="#E0E0E0" Foreground="#333" BorderThickness="0"
                        Click="BtnCancel_Click"/>
            </Grid>

            <!-- 2: Yakinlastirma araclari -->
            <DockPanel x:Name="ZoomBar" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button x:Name="BtnZoomOut" Content="−" Width="42" Height="32" FontSize="20" FontWeight="Bold"
                            Margin="0,0,6,0" Background="#ECEFF4" BorderThickness="0" Click="BtnZoomOut_Click"/>
                    <Button x:Name="BtnZoomIn" Content="+" Width="42" Height="32" FontSize="20" FontWeight="Bold"
                            Margin="0,0,6,0" Background="#ECEFF4" BorderThickness="0" Click="BtnZoomIn_Click"/>
                    <Button x:Name="BtnZoomReset" Content="Sifirla" Width="86" Height="32" FontSize="14"
                            Margin="0,0,10,0" Background="#ECEFF4" BorderThickness="0" Click="BtnZoomReset_Click"/>
                    <Border Background="#1B2B4A" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
                        <TextBlock x:Name="LblZoom" Text="%100" Foreground="White" FontSize="13" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Arac Fotografi  —  tekerlek: yakinlastir, surukle: gezdir, cift tik: sifirla"
                           Foreground="#6B7A99" FontSize="14" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- 3: Fotograf — kalan alani kaplar, ekrana sigmak icin KUCULUR -->
            <Border x:Name="PhotoPanel" Grid.Row="3" Visibility="Collapsed"
                    CornerRadius="10" BorderBrush="#DDE3EE" BorderThickness="1"
                    ClipToBounds="True" Background="#111" MinHeight="200">
                <ScrollViewer x:Name="ImgScroll"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Cursor="Hand"
                              PreviewMouseWheel="ImgScroll_PreviewMouseWheel"
                              PreviewMouseLeftButtonDown="ImgScroll_MouseDown"
                              PreviewMouseMove="ImgScroll_MouseMove"
                              PreviewMouseLeftButtonUp="ImgScroll_MouseUp"
                              MouseDoubleClick="ImgScroll_DoubleClick">
                    <Image x:Name="ImgPlate" Stretch="Uniform">
                        <Image.LayoutTransform>
                            <ScaleTransform x:Name="ImgScale" ScaleX="1" ScaleY="1"/>
                        </Image.LayoutTransform>
                    </Image>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
