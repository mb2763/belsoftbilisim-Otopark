<UserControl x:Class="Otopark.Client.Views.PersonnelDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Otopark.Client.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToColorConverter x:Key="BoolToColor"/>
        <conv:PathToImageConverter x:Key="PathToImage"/>
    </UserControl.Resources>

    <Grid Background="#F5F7FB">

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto" MaxHeight="120"/>
            </Grid.RowDefinitions>

            <!-- ================= TOP BAR (KPI + Kullanici sabit sagda) ================= -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: KPI'lar (WrapPanel - dar ekranda alt satira gecer) -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal">

                    <Border MinWidth="115" Margin="3" Background="White" CornerRadius="10" Padding="8,6"
                            BorderBrush="#E6EAF2" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Hasilat" Foreground="Gray" FontSize="10"/>
                            <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:F0} TL'}" FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border MinWidth="115" Margin="3" Background="White" CornerRadius="10" Padding="8,6"
                            BorderBrush="#E6EAF2" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Abonelik" Foreground="Gray" FontSize="10"/>
                            <TextBlock Text="{Binding SubscriptionRevenue, StringFormat='{}{0:F0} TL'}" FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border MinWidth="95" Margin="3" Background="White" CornerRadius="10" Padding="8,6"
                            BorderBrush="#E6EAF2" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Kapasite" Foreground="Gray" FontSize="10"/>
                            <TextBlock Text="{Binding TotalCapacity}" FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border MinWidth="95" Margin="3" Background="White" CornerRadius="10" Padding="8,6"
                            BorderBrush="#E6EAF2" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Park Sayisi" Foreground="Gray" FontSize="10"/>
                            <TextBlock Text="{Binding CurrentVehicleCount}" FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border MinWidth="95" Margin="3" Background="White" CornerRadius="10" Padding="8,6"
                            BorderBrush="#E6EAF2" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Bos" Foreground="Gray" FontSize="10"/>
                            <TextBlock Text="{Binding EmptyParkCount}" FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Kara Liste"
                            MinWidth="90" Height="36" Margin="3" FontSize="11"
                            Background="White" BorderBrush="#DDE3EE"
                            VerticalAlignment="Center"/>

                    <Button Content="Borc Kontrol"
                            MinWidth="90" Height="36" Margin="3" FontSize="11"
                            Background="White" BorderBrush="#DDE3EE"
                            VerticalAlignment="Center"/>

                    <Button Content="Yıkama"
                            MinWidth="90" Height="36" Margin="3" FontSize="11"
                            Background="#2563EB" Foreground="White" BorderBrush="#1D4ED8"
                            VerticalAlignment="Center"
                            Click="Wash_Click"/>

                    <!-- Kamera + Bariyer Paneli -->
                    <Border MinWidth="245" Height="60" Margin="3"
                            Background="White" CornerRadius="10" Padding="4"
                            BorderBrush="#E6EAF2" BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel Margin="3">
                                <Border Width="52" Height="22" Background="#D9F0FF" CornerRadius="6">
                                    <TextBlock Text="Kam." FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Button Content="G" Width="22" Height="18"
                                            Background="#5ACF90" Foreground="White" FontSize="9" Margin="1"
                                            Click="EntryCapture_Click"/>
                                    <Button Content="C" Width="22" Height="18"
                                            Background="#5ACF90" Foreground="White" FontSize="9" Margin="1"
                                            Click="ExitCapture_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="3">
                                <Border Width="52" Height="22" Background="#F2E6FF" CornerRadius="6">
                                    <TextBlock Text="Bar." FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Button Content="G" Width="22" Height="18"
                                            Background="#444" Foreground="White" FontSize="9" Margin="1"
                                            Click="BarrierEntry_Click"/>
                                    <Button Content="C" Width="22" Height="18"
                                            Background="#444" Foreground="White" FontSize="9" Margin="1"
                                            Click="BarrierExit_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Kameralari durdur/baslat: giris-cikis islemeyi acar/kapatir -->
                            <StackPanel Margin="6,3,3,3" VerticalAlignment="Center">
                                <Button x:Name="BtnToggleCameras" Content="Kameralar: ACIK"
                                        Width="100" Height="48" FontSize="10" FontWeight="Bold"
                                        Background="#5ACF90" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        Click="ToggleCameras_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Sag: Kullanici + Bolge + Cikis (SABIT) -->
                <Border Grid.Column="1" Background="White" CornerRadius="10"
                        BorderBrush="#E6EAF2" BorderThickness="1"
                        Padding="10,6" Margin="3"
                        MinWidth="220" Height="60"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Kurum logosu: CIFT TIKLAMA -> yonetici sifresi -> programi kapat.
                             (Uygulama tam ekran calistigi icin baslik cubugu/kapatma butonu yoktur.) -->
                        <Image Grid.Column="0" Source="pack://application:,,,/Assets/kurum_logo.png"
                               Height="42" Margin="0,0,10,0" VerticalAlignment="Center"
                               Cursor="Hand" ToolTip="Programı kapatmak için çift tıklayınız"
                               MouseLeftButtonDown="KurumLogo_MouseDown"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="11" TextTrimming="CharacterEllipsis">
                                <Run Text="Hosgeldin, " Foreground="Gray"/>
                                <Run Text="{Binding LoggedUserName}" FontWeight="Bold" Foreground="#1B2B4A"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                <Run Text="Bolge: " Foreground="Gray"/>
                                <Run Text="{Binding LoggedZoneName}" FontWeight="SemiBold" Foreground="#2B7CFF"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Cikis"
                                    Height="26" Padding="12,0"
                                    Background="#FF5A5A" Foreground="White"
                                    FontSize="11" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding LogoutCommand}" Margin="8,0,0,0"/>
                            <!-- Programi kapat: kullanici dogrudan kapatabilir (onay sorulur). -->
                            <Button Content="KAPAT" ToolTip="Programı kapat"
                                    Height="26" Padding="12,0"
                                    Background="#374151" Foreground="White"
                                    FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                    Margin="6,0,0,0" Click="CloseApp_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= MIDDLE: LEFT + RIGHT ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3.5*" MinWidth="780"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1*" MinWidth="260"/>
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT PANEL ================= -->
                <Border Grid.Column="0"
                        Background="White" CornerRadius="14"
                        BorderBrush="#E6EAF2" BorderThickness="1"
                        Padding="12" Margin="0,0,0,10">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="200"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Filter Row -->
                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Grid Width="180" Margin="0,0,10,4">
                                <TextBox x:Name="PlateSearchText"
                                         Height="30" VerticalContentAlignment="Center" Padding="8,0"
                                         Text="{Binding PlateSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Plaka Giriniz" Foreground="#999"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PlateSearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Content="FILTRELE" MinWidth="100" Height="30"
                                    Background="#5ACF90" Foreground="White"
                                    Command="{Binding ApplyFiltersCommand}"/>
                        </WrapPanel>

                        <!-- Vehicle Table -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding VehicleList}"
                                  SelectedItem="{Binding SelectedVehicle, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  RowHeight="42"
                                  ColumnHeaderHeight="28"
                                  FontSize="11"
                                  BorderBrush="#E6EAF2"
                                  GridLinesVisibility="Horizontal"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  Margin="0,0,0,6">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                    <Setter Property="Foreground" Value="#1B5E20"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ParkType}" Value="Cikis">
                                            <Setter Property="Background" Value="#FFEBEE"/>
                                            <Setter Property="Foreground" Value="#B71C1C"/>
                                        </DataTrigger>
                                        <!-- Kara liste: odenmemis borcu olan arac -> siyah arka plan (en son trigger oncelikli) -->
                                        <DataTrigger Binding="{Binding IsBlacklisted}" Value="True">
                                            <Setter Property="Background" Value="#1A1A1A"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PLAKA" Binding="{Binding Plate}" Width="85" FontWeight="Bold"/>

                                <!-- ARAC GIRIS TURU: A (yesil) abone, N (sari) normal -->
                                <DataGridTemplateColumn Header="GIR.TURU" Width="58">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="4,2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FFE57F"/>
                                                        <Setter Property="BorderBrush" Value="#B0A040"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EntryType}" Value="A">
                                                                <Setter Property="Background" Value="#5ACF90"/>
                                                                <Setter Property="BorderBrush" Value="#2E8B57"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding EntryType}"
                                                           FontWeight="Bold" FontSize="13"
                                                           Foreground="#1B2B4A"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ABONELIK TURU: sadece abone ise dolu -->
                                <DataGridTextColumn Header="ABONELIK" Binding="{Binding SubscriptionName}" Width="110"/>

                                <DataGridTextColumn Header="OTOPARK" Binding="{Binding ParkingName}" Width="*" MinWidth="80"/>
                                <DataGridTextColumn Header="SURE" Binding="{Binding DurationText}" Width="60"/>
                                <DataGridTextColumn Header="TIP" Binding="{Binding ParkType}" Width="55"/>
                                <DataGridTextColumn Header="GIRIS" Binding="{Binding EntryDateTime, StringFormat=dd.MM HH:mm}" Width="90"/>

                                <DataGridTemplateColumn Header="Plk Gir" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="80" Height="38"
                                                    Background="#EEE" CornerRadius="5"
                                                    BorderBrush="#DDD" BorderThickness="1"
                                                    Cursor="Hand" Tag="entry"
                                                    MouseLeftButtonDown="PlateImage_MouseDown">
                                                <Image Source="{Binding EntryPlateImagePath, Converter={StaticResource PathToImage}}"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsHitTestVisible="False"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="CIKIS" Binding="{Binding ExitDateTime, StringFormat=dd.MM HH:mm}" Width="90"/>

                                <DataGridTemplateColumn Header="Plk Cik" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="80" Height="38"
                                                    Background="#EEE" CornerRadius="5"
                                                    BorderBrush="#DDD" BorderThickness="1"
                                                    Cursor="Hand" Tag="exit"
                                                    MouseLeftButtonDown="PlateImage_MouseDown">
                                                <Image Source="{Binding ExitPlateImagePath, Converter={StaticResource PathToImage}}"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsHitTestVisible="False"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="ESKI" Binding="{Binding OldDebt, StringFormat=N2}" Width="65"/>
                                <DataGridTextColumn Header="ANLIK" Binding="{Binding CurrentDebt, StringFormat=N2}" Width="65"/>
                                <DataGridTextColumn Header="TOPLAM" Binding="{Binding TotalDebt, StringFormat=N2}" Width="75"/>

                                <!-- "Duzelt" butonu KALDIRILDI: plaka duzeltme artik satirdaki
                                     arac FOTOGRAFINA tiklanarak yapilir (eski plaka gorunur + yeni plaka girilir). -->

                                <DataGridTemplateColumn Header="" Width="55">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Iptal" Height="24" Margin="1"
                                                    Background="#E53935" Foreground="White"
                                                    BorderThickness="0" FontSize="10"
                                                    Command="{Binding DataContext.CancelEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Filters + Zone Cards -->
                        <Grid Grid.Row="2" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sol: Durum filtresi (kompakt) -->
                            <Border Grid.Column="0" Background="#F2F2F2" CornerRadius="6"
                                    Padding="6,4" Margin="0,0,4,0" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Durum" FontWeight="Bold" FontSize="11" Margin="0,0,0,2"/>
                                    <RadioButton Content="Tumu" GroupName="Durum" FontSize="11"
                                                 IsChecked="{Binding IsStatusAllInOut}"/>
                                    <RadioButton Content="Onaylilar (Cikis)" GroupName="Durum" FontSize="11"
                                                 IsChecked="{Binding IsStatusApproved}"/>
                                    <RadioButton Content="Onaysizlar (Giris)" GroupName="Durum" FontSize="11"
                                                 IsChecked="{Binding IsStatusUnapprovedOnly}"/>
                                    <RadioButton Content="Iptaller" GroupName="Durum" FontSize="11"
                                                 IsChecked="{Binding IsStatusCancelled}"/>
                                    <RadioButton Content="Kara Liste" GroupName="Durum" FontSize="11"
                                                 Foreground="#B71C1C" FontWeight="Bold"
                                                 IsChecked="{Binding IsStatusBlacklist}"/>
                                </StackPanel>
                            </Border>

                            <!-- Orta: Zaman filtresi -->
                            <Border Grid.Column="1" Background="#F2F2F2" CornerRadius="6"
                                    Padding="6,4" Margin="0,0,4,0" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Zaman" FontWeight="Bold" FontSize="11" Margin="0,0,0,2"/>
                                    <RadioButton Content="Bu Mesai" GroupName="Zaman" FontSize="11"
                                                 IsChecked="{Binding IsTimeShift}"/>
                                    <RadioButton Content="Gun" GroupName="Zaman" FontSize="11"
                                                 IsChecked="{Binding IsTimeDay}"/>
                                    <RadioButton Content="Hafta" GroupName="Zaman" FontSize="11"
                                                 IsChecked="{Binding IsTimeWeek}"/>
                                    <RadioButton Content="Ay" GroupName="Zaman" FontSize="11"
                                                 IsChecked="{Binding IsTimeMonth}"/>
                                </StackPanel>
                            </Border>

                            <!-- Sag: Bolge kartlari - SIMDILIK GIZLI (site tarafindan yonetilecek) -->
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Visibility="Collapsed">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="Bolge Secimi" FontWeight="Bold" FontSize="11" Margin="0,0,0,3"/>
                                    <ListBox ItemsSource="{Binding AllZones}"
                                             SelectedItem="{Binding SelectedAdminZone, Mode=TwoWay}"
                                             BorderThickness="0" Background="Transparent"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Margin" Value="2"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Card"
                                                                    MinWidth="100" Height="32"
                                                                    CornerRadius="5"
                                                                    Background="#EDEDED"
                                                                    BorderBrush="#D6D6D6"
                                                                    BorderThickness="1"
                                                                    Padding="6,0">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Card" Property="Background" Value="#2B7CFF"/>
                                                                    <Setter TargetName="Card" Property="BorderBrush" Value="#1A5DC8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ZoneName}"
                                                           FontWeight="SemiBold" FontSize="11"
                                                           TextAlignment="Center" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#333"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Buttons -->
                        <WrapPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <Button Content="Cift Okuma" MinWidth="90" Margin="2" Height="26" FontSize="11"/>
                            <Button Content="Vazgecen" MinWidth="90" Margin="2" Height="26" FontSize="11"/>
                            <Button Content="Sayim Iptal" MinWidth="90" Margin="2" Height="26" FontSize="11"/>
                            <Button Content="Borc Sorgula" MinWidth="90" Margin="2" Height="26" FontSize="11"/>
                        </WrapPanel>

                    </Grid>
                </Border>

                <!-- ================= RIGHT PANEL: ARAC GIRIS + ARAC CIKIS eşit dağılım ================= -->
                <Grid Grid.Column="2" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                        <!-- ===== ARAC GIRIS (Row 0) ===== -->
                        <Border Grid.Row="0" Background="White" CornerRadius="12"
                                BorderBrush="#E6EAF2" BorderThickness="1"
                                Padding="8" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="ARAC GIRIS" FontWeight="Bold" FontSize="12"
                                           Foreground="#2B7CFF" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Fis Bas" Height="28"
                                            Margin="2" Background="#B8EACB" FontSize="11"
                                            Command="{Binding ApproveAndPrintEntryCommand}"/>
                                    <Button Grid.Column="1" Content="Onayla" Height="28"
                                            Margin="2" Background="#B8EACB" FontSize="11"
                                            Command="{Binding ApproveEntryCommand}"/>
                                </Grid>

                                <TextBox Height="30"
                                         Text="{Binding EntryDetectedPlate, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="14" FontWeight="Bold"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,0,4"/>

                                <Border Background="#F0F3F9" CornerRadius="8"
                                        MinHeight="90" MaxHeight="160">
                                    <Image Source="{Binding EntryCameraImagePath, Converter={StaticResource PathToImage}, ConverterParameter=600}" Stretch="Uniform"/>
                                </Border>

                                <WrapPanel HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <Border Width="70" Height="44" Background="#EEE" Margin="2"
                                            CornerRadius="5" BorderBrush="#DDD" BorderThickness="1">
                                        <Image Source="{Binding EntryPhoto1, Converter={StaticResource PathToImage}}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border Width="70" Height="44" Background="#EEE" Margin="2"
                                            CornerRadius="5" BorderBrush="#DDD" BorderThickness="1">
                                        <Image Source="{Binding EntryPhoto2, Converter={StaticResource PathToImage}}" Stretch="UniformToFill"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- ===== ARAC CIKIS (Row 1) ===== -->
                        <Border Grid.Row="1" Background="White" CornerRadius="12"
                                BorderBrush="#E6EAF2" BorderThickness="1"
                                Padding="8">
                            <StackPanel>
                                <TextBlock Text="ARAC CIKIS" FontWeight="Bold" FontSize="12"
                                           Foreground="#E74C3C" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Fis Bas" Height="28"
                                            Margin="2" Background="#FDDEDE" FontSize="11"
                                            Command="{Binding ApproveAndPrintExitCommand}"/>
                                    <Button Grid.Column="1" Content="Onayla" Height="28"
                                            Margin="2" Background="#FDDEDE" FontSize="11"
                                            Command="{Binding ApproveExitCommand}"/>
                                </Grid>

                                <TextBox Height="30"
                                         Text="{Binding ExitDetectedPlate, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="14" FontWeight="Bold"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,0,4"/>

                                <!-- Cikis kamerasi (anlik goruntu) -->
                                <Border Background="#FDF0F0" CornerRadius="8"
                                        MinHeight="90" MaxHeight="160">
                                    <Image Source="{Binding ExitCameraImagePath, Converter={StaticResource PathToImage}, ConverterParameter=600}" Stretch="Uniform"/>
                                </Border>

                                <WrapPanel HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <Border Width="70" Height="44" Background="#EEE" Margin="2"
                                            CornerRadius="5" BorderBrush="#DDD" BorderThickness="1">
                                        <Image Source="{Binding ExitPhoto1, Converter={StaticResource PathToImage}}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border Width="70" Height="44" Background="#EEE" Margin="2"
                                            CornerRadius="5" BorderBrush="#DDD" BorderThickness="1">
                                        <Image Source="{Binding ExitPhoto2, Converter={StaticResource PathToImage}}" Stretch="UniformToFill"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                </Grid>

            </Grid>

            <!-- ================= BOTTOM ================= -->
            <Border Grid.Row="2"
                    Background="White" CornerRadius="14"
                    BorderBrush="#E6EAF2" BorderThickness="1"
                    Padding="8,6">

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Kacirmalardan Al"
                               FontWeight="Bold" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Grid Width="180" Margin="0,0,8,0">
                        <TextBox x:Name="MissedPlateText"
                                 Text="{Binding MissedPlateInput, UpdateSourceTrigger=PropertyChanged}"
                                 CharacterCasing="Upper" MaxLength="10"
                                 Height="30" VerticalContentAlignment="Center" Padding="8,0"/>
                        <TextBlock Text="Plaka Giriniz" Foreground="#999"
                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=MissedPlateText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Content="Iceri Al" MinWidth="80" Height="30"
                            Background="#5ACF90" Foreground="White"
                            Command="{Binding ImportMissedCommand}"/>
                    <Button Content="Disari Al" MinWidth="80" Height="30" Margin="8,0,0,0"
                            Background="#E67E7E" Foreground="White"
                            Command="{Binding ImportMissedExitCommand}"/>
                </WrapPanel>
            </Border>

        </Grid>

        <!-- Toast Bildirim -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,0"
                Padding="20,12"
                CornerRadius="10"
                MinWidth="300"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
                Background="{Binding IsToastSuccess, Converter={StaticResource BoolToColor}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Opacity="0.3" ShadowDepth="3"/>
            </Border.Effect>
            <TextBlock Text="{Binding ToastMessage}"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
        </Border>

    </Grid>
</UserControl>
