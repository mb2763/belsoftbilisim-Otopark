<Window x:Class="Otopark.Client.Views.ExitPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programdan Cikis"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True">

    <Border Background="White" CornerRadius="14" Padding="22" Margin="10"
            BorderBrush="#E5E7EB" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.25"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="PROGRAMDAN ÇIKIŞ" FontSize="17" FontWeight="Bold"
                       Foreground="#1B2B4A" HorizontalAlignment="Center"/>
            <TextBlock Text="Kapatmak için yönetici şifresini giriniz."
                       FontSize="12" Foreground="#6B7A99"
                       HorizontalAlignment="Center" Margin="0,6,0,14" TextWrapping="Wrap"/>

            <PasswordBox x:Name="TxtPassword" Height="38" FontSize="18"
                         Padding="8,0" VerticalContentAlignment="Center"
                         KeyDown="TxtPassword_KeyDown"/>

            <TextBlock x:Name="TxtError" Text="" Foreground="#DC2626" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="BtnCancel" Content="Vazgeç" Width="95" Height="34"
                        Margin="0,0,8,0" Background="#E5E7EB" BorderThickness="0"
                        Cursor="Hand" Click="BtnCancel_Click"/>
                <Button x:Name="BtnOk" Content="Kapat" Width="110" Height="34"
                        Background="#DC2626" Foreground="White" BorderThickness="0"
                        FontWeight="Bold" Cursor="Hand" Click="BtnOk_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
