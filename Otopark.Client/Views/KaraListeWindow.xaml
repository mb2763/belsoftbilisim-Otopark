<Window x:Class="Otopark.Client.Views.KaraListeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kara Liste"
        Width="720" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FB">

    <Border Margin="18" Background="White" CornerRadius="14" Padding="26"
            BorderBrush="#E6EAF2" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Kara Listeye Ekle" FontSize="24" FontWeight="Bold"
                       Foreground="#111827" HorizontalAlignment="Center" Margin="0,0,0,14"/>

            <TextBlock x:Name="TxtPlate" FontSize="30" FontWeight="Bold" Foreground="#1B2B4A"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <!-- NE YAPTIGINI ACIKCA YAZ: personel sonucunu bilsin. -->
            <Border Background="#F3F4F6" CornerRadius="10"
                    BorderBrush="#111827" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Arac borcunu odeyene kadar HICBIR kapali otoparka giremez."
                               FontWeight="Bold" FontSize="15" Foreground="#111827" Margin="0,0,0,6"/>
                    <TextBlock FontSize="14" Foreground="#37474F" TextWrapping="Wrap"
                               Text="Aracin acik girisi borclu cikisla kapatilir; borc kayitta kalir. Borc kioskta ya da online odenince kayit kendiliginden kapanir. Yanlis eklemeyi web panelinden 'Kara Liste' ekranindan yetkili kaldirir."/>
                </StackPanel>
            </Border>

            <TextBlock Text="Neden (zorunlu)" Foreground="#6B7A99" FontSize="15" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtNote" Height="90" FontSize="18" Padding="10"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                     BorderBrush="#111827" BorderThickness="2"
                     KeyDown="TxtNote_KeyDown"/>
            <TextBlock Text="Ornek: Odeme yapmadan arkadan cikti (kamera kaydi 14:32)"
                       Foreground="#9AA5B8" FontSize="12" Margin="2,4,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="BtnVazgec" Content="Vazgec" Width="150" Height="52" FontSize="19" Margin="0,0,12,0"
                        Background="#E0E0E0" Foreground="#333" BorderThickness="0"
                        Click="BtnVazgec_Click"/>
                <Button x:Name="BtnOnayla" Content="Listeye Ekle" Width="200" Height="52" FontSize="19"
                        Background="#111827" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Click="BtnOnayla_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
